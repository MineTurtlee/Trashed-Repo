						<key>style</key>
						<string>Regular</string>
						<key>trademark</key>
						<string>PT Serif is a trademark of the ParaType Ltd.</string>
						<key>unique</key>
						<string>PT Serif Caption; 13.0d2e1; 2017-06-29</string>
						<key>valid</key>
						<string>yes</string>
						<key>vendor</key>
